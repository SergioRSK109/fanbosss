# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CinetPay (docs.cinetpay.com)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# Secret key used to verify the x-token HMAC on incoming webhooks. Distinct
# from CINETPAY_API_KEY. See src/lib/cinetpay.ts.
CINETPAY_SECRET_KEY=

# Cloudflare R2 (private bucket - see src/lib/r2.ts)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Vercel Cron: the deadline-check route only accepts requests carrying this
# secret as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Anthropic API (automatic publication moderation -- see src/lib/moderation.ts).
# Server-side only, never exposed to the client.
ANTHROPIC_API_KEY=
